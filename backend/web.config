<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site: seoaudit.theonetechnologies.co.in  (SEO Audit API)
  Physical path: D:\WWW\SEO-audit\backend

  Requires URL Rewrite + ARR with "Enable proxy" ON at the server node
  (already enabled in applicationHost.config on this server).

  Every request is forwarded to the uvicorn process on 127.0.0.1:8005.
  IIS does NOT start uvicorn - it runs separately (see note below).
-->
<configuration>
  <system.webServer>

    <!-- WebDAV hijacks DELETE/PUT/PATCH before they reach the app.
         This API exposes DELETE /api/projects/{id} and /api/crawl-runs/{id}. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="SEOAudit-ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8005/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- Block direct access to source/config files at the IIS layer -->
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="venv" />
          <add segment=".env" />
          <add segment="app" />
          <add segment="data" />
          <add segment="alembic" />
          <add segment="scripts" />
          <add segment="tests" />
          <add segment="__pycache__" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
