{
  "manifest_version": 3,
  "name": "SEO Audit",
  "version": "0.1.0",
  "description": "Crawl and audit websites for SEO issues. Dashboard, issues, pages, reports, and a current-page checker.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open SEO Audit"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://seoaudit.theonetechnologies.co.in/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
