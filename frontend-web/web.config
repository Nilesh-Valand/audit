<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site: seoaudit-frontend.theonetechnologies.co.in  (SEO Audit web UI)
  Physical path: D:\WWW\SEO-audit\frontend-web

  Requires URL Rewrite + ARR with "Enable proxy" ON at the server node
  (already enabled in applicationHost.config on this server).

  Every request is forwarded to the Next.js server on 127.0.0.1:3001, which
  runs under PM2 as "seo-audit-frontend" (next start -p 3001). IIS does NOT
  start Next.js and serves no files from this folder itself - .next/static,
  /public assets and all routes are handled by the Node process.
-->
<configuration>
  <system.webServer>

    <!-- WebDAV intercepts non-GET verbs before they reach the app. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="SEOAuditFrontend-ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
